  mso-fareast-language: EN-US;
}

span.MsoCommentReference {
  mso-style-noshow: yes;
  mso-style-priority: 99;
  mso-style-parent: "";
  mso-ansi-font-size: 9pt;
  mso-bidi-font-size: 9pt;
}

p.MsoCommentSubject, li.MsoCommentSubject, div.MsoCommentSubject {
  mso-style-noshow: yes;
  mso-style-priority: 99;
  mso-style-parent: "Comment Text";
  mso-style-link: "Comment Subject Char";
  mso-style-next: "Comment Text";
  margin-top: 0cm;
  margin-right: 0cm;
  margin-bottom: 12pt;
  margin-left: 0cm;
  text-align: justify;
  line-height: 12pt;
  mso-pagination: widow-orphan;
  tab-stops: 20.15pt;
  font-size: 10pt;
  font-family: "Cambria",serif;
  mso-fareast-font-family: "SimHei", serif;
  mso-bidi-font-family: "Cambria",serif;
  mso-ansi-language: EN-GB;
  mso-fareast-language: EN-US;
  font-weight: bold;
}

p.Tablebody, li.Tablebody, div.Tablebody {
  mso-style-name: "Table body";
  mso-style-noshow: yes;
  mso-style-unhide: no;
  margin-top: 3pt;
  margin-right: 0cm;
  margin-bottom: 3pt;
  margin-left: 0cm;
  line-height: 12pt;
  mso-pagination: widow-orphan;
  font-size: 10.0pt;
  mso-bidi-font-size: 11.0pt;
  font-family: "Cambria",serif;
  mso-fareast-font-family: "SimSun", serif;
  mso-bidi-font-family: "Cambria",serif;
  mso-ansi-language: EN-GB;
}

.MsoChpDefault {
  mso-style-type: export-only;
  mso-default-props: yes;
  font-family: "Cambria",serif;
  font-size: 10pt;
  mso-ascii-font-family: "Cambria",serif;
  mso-fareast-font-family: "SimSun", serif;
  mso-hansi-font-family: "Cambria",serif;
}

p.TOCTitle, li.TOCTitle, div.TOCTitle {
  mso-style-name: "TOC Title";
  mso-style-unhide: no;
  margin-top: 0in;
  margin-right: 0in;
  margin-bottom: 11.0pt;
  margin-left: 0in;
  text-align: left;
  page-break-after: avoid;
  mso-pagination: none;
  mso-hyphenate: none;
  mso-layout-grid-align: none;
  font-size: 11.0pt;
  mso-bidi-font-size: 10pt;
  font-weight: bold;
  font-family: "Cambria",serif;
  mso-fareast-font-family: "Cambria",serif;
  mso-bidi-font-family: "Cambria",serif;
  mso-fareast-language: EN-US;
}

/* Page Definitions */
@page {
